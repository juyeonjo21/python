# ============================================================
# ERP 문의 관리 시스템 환경 설정
# ============================================================

# Django 보안 키 (외부에 절대 공개 금지)
SECRET_KEY='여기에-새-비밀키를-넣으세요'

# 개발 중 True / 운영 서버 False
DEBUG=True

# 접속 허용 도메인 (쉼표로 구분)
ALLOWED_HOSTS=localhost,127.0.0.1

# 데이터베이스 - 비워두면 프로젝트 폴더의 db.sqlite3 사용
# 운영 예시: postgres://사용자:비밀번호@호스트:5432/DB이름
# DATABASE_URL=

# 샘플 데이터(seed_data) 계정의 공통 비밀번호 - 개발용
SEED_PASSWORD=erp1234!

# ------------------------------------------------------------
# 이메일 알림
# ------------------------------------------------------------
# 개발: 터미널에 메일 내용을 보기 좋게 출력 (실제로 보내지 않음)
EMAIL_BACKEND=notifications.backends.ReadableConsoleEmailBackend
# 운영(실제 발송) 예시 - 아래 줄의 주석을 풀고 위 줄을 지움
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
# 메일 계정 비밀번호는 이 파일(.env)에만 적습니다
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=ERP Helpdesk <no-reply@example.com>

# 개발용: 값을 넣으면 모든 알림 메일을 이 주소 한 곳으로만 보냄
# (제목 앞에 [원래 수신: 원래주소]가 붙음) - 운영에서는 반드시 비워 둘 것
EMAIL_REDIRECT_TO=

# 메일 속 링크의 앞부분 (서버 주소)
SITE_URL=http://127.0.0.1:8001

# ------------------------------------------------------------
# 실제 메일 서버 설정 예시 (사용할 블록만 위 값에 옮겨 적기)
# 설정 후 확인: python manage.py send_test_email 받는주소
# ------------------------------------------------------------
# [사내 Exchange / 그룹웨어 SMTP] 서버 주소·포트·인증 방식은 전산팀에 확인
#   (A) 인증 + 암호화(권장)
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=mail.회사도메인          # 예: smtp.회사도메인, mail.회사도메인
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_USE_SSL=False
#   EMAIL_HOST_USER=erp-helpdesk@회사도메인   # Exchange는 '도메인\아이디' 형식일 수도 있음
#   EMAIL_HOST_PASSWORD=(계정 비밀번호)
#   DEFAULT_FROM_EMAIL=ERP Helpdesk <erp-helpdesk@회사도메인>
#   (B) 사내 내부 릴레이 (서버 IP를 허용 목록에 등록, 인증 없음)
#   EMAIL_PORT=25 / EMAIL_USE_TLS=False / EMAIL_USE_SSL=False / EMAIL_HOST_USER= / EMAIL_HOST_PASSWORD=
#   (C) 465 포트(SSL)만 여는 그룹웨어
#   EMAIL_PORT=465 / EMAIL_USE_TLS=False / EMAIL_USE_SSL=True
#
# [Microsoft 365] EMAIL_HOST=smtp.office365.com / 587 / TLS=True
#   계정에 SMTP AUTH 허용 필요, MFA 계정은 앱 비밀번호 필요
# [Gmail(Google Workspace)] EMAIL_HOST=smtp.gmail.com / 587 / TLS=True
#   2단계 인증 + 앱 비밀번호(16자리) 필요
