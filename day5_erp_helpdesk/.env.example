# Django 보안 키 (외부에 절대 공개 금지)
SECRET_KEY='여기에-새-비밀키를-넣으세요'

# 개발 중 True / 운영 서버 False
DEBUG=True

# 접속 허용 도메인 (쉼표로 구분)
ALLOWED_HOSTS=localhost,127.0.0.1

# 데이터베이스 - 비워두면 프로젝트 폴더의 db.sqlite3 사용
# 운영 예시: postgres://사용자:비밀번호@호스트:5432/DB이름
# DATABASE_URL=

# 샘플 데이터(seed_data) 계정의 공통 비밀번호 - 개발용
SEED_PASSWORD=erp1234!
